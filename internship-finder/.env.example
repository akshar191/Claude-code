# Copy to .env and fill in what you have. Everything is optional --
# with zero keys the app still works using the free sources (OpenStreetMap +
# company website crawling + email pattern inference).

# Identifies you to the sites you crawl. Set this -- it is the polite thing to
# do and some hosts block requests without a contact address.
CONTACT_EMAIL=you@school.edu

# --- Optional paid providers -------------------------------------------------
# Hunter.io: domain -> known emails + the company's email pattern. Best value
# for this use case; free tier is 25 searches/month.
HUNTER_API_KEY=

# Apollo.io: company search with real employee-count filters, plus contacts.
APOLLO_API_KEY=

# RocketReach: LinkedIn profile URL -> email.
ROCKETREACH_API_KEY=

# Google Places: much better company discovery than OpenStreetMap.
GOOGLE_PLACES_API_KEY=

# --- Crawler behaviour -------------------------------------------------------
RESPECT_ROBOTS=true
CRAWL_DELAY=1.0
REQUEST_TIMEOUT=12
MAX_PAGES_PER_SITE=8

# SMTP mailbox probing. Off by default: most cloud/campus networks block
# outbound port 25, and aggressive probing gets your IP blocklisted. Only turn
# this on from a residential connection, and leave the delay generous.
ENABLE_SMTP_PROBE=false
SMTP_FROM=verify@example.com
