# Copy to .env and fill in what you have. Everything is optional --
# with zero keys the app still works using the free sources (OpenStreetMap +
# company website crawling + email pattern inference).

# Identifies you to the sites you crawl. Set this -- it is the polite thing to
# do and some hosts block requests without a contact address.
CONTACT_EMAIL=you@school.edu

# --- Optional paid providers -------------------------------------------------
# Hunter.io: domain -> known emails + the company's email pattern. Best value
# for this use case; free tier is 25 searches/month.
HUNTER_API_KEY=

# Cap on Hunter email-verifier calls per search. Verifications spend from the
# same small free tier as domain lookups, so without a cap a single 10-company
# run can drain your month. Raise it if you are on a paid plan.
HUNTER_VERIFY_BUDGET=10

# Per-company headcount lookups (companies/find). Fills in "size not confirmed"
# so the max-employees filter has something to act on. One call per company.
HUNTER_COMPANY_BUDGET=8

# Apollo.io: company search with real employee-count filters, plus contacts.
APOLLO_API_KEY=

# RocketReach: LinkedIn profile URL -> email.
ROCKETREACH_API_KEY=

# Google Places: much better company discovery than OpenStreetMap.
GOOGLE_PLACES_API_KEY=

# --- Public deployment -------------------------------------------------------
APP_PASSWORD=            # required; the app serves nothing without it
SECRET_KEY=              # signs the session cookie
DAILY_SEARCH_LIMIT=2
MAX_COMPANIES_PER_SEARCH=5

# --- Gmail drafts ------------------------------------------------------------
# OAuth client (type: Web application) from console.cloud.google.com.
# The scope requested is gmail.compose: create drafts, never send.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Who you are (used in the drafts) ----------------------------------------
APPLICANT_NAME=
APPLICANT_YEAR=high school junior
APPLICANT_TOWN=Ashland, MA
APPLICANT_WORK=a contractor at Silverside Detectors, assembling lithium-6 neutron detectors
APPLICANT_VENTURE=founder of a mobile detailing business
APPLICANT_TARGET=summer 2027

# --- Crawler behaviour -------------------------------------------------------
RESPECT_ROBOTS=true

# OpenStreetMap/Overpass. Off by default: both public mirrors time out routinely
# and add ~45s per run for nothing once Google Places is configured.
ENABLE_OPENSTREETMAP=false
CRAWL_DELAY=1.0
REQUEST_TIMEOUT=12
MAX_PAGES_PER_SITE=8

# SMTP mailbox probing. Off by default: most cloud/campus networks block
# outbound port 25, and aggressive probing gets your IP blocklisted. Only turn
# this on from a residential connection, and leave the delay generous.
ENABLE_SMTP_PROBE=false
SMTP_FROM=verify@example.com
